{
  "name": "bullet-poker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --filter '!@bullet-poker/e2e' run test && pnpm --filter @bullet-poker/e2e run test",
    "test:watch": "pnpm --filter @bullet-poker/common run test:watch",
    "test:integration": "pnpm --filter @bullet-poker/server run test:integration",
    "test:all": "pnpm -r --filter '!@bullet-poker/e2e' run test:all && pnpm --filter @bullet-poker/e2e run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
