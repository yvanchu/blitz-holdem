{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install && pnpm --filter @blitz-holdem/client run build"
  },
  "deploy": {
    "startCommand": "npx serve packages/client/dist -s -l $PORT",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30
  }
}
