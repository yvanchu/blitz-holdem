{
  "name": "@blitz-holdem/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:integration": "vitest run --dir src/__tests__/integration",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@blitz-holdem/common": "workspace:*",
    "express": "^4.18.2",
    "nanoid": "^5.0.4",
    "tsx": "^4.7.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "vitest": "^1.2.0"
  }
}
