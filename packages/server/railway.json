{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install && pnpm --filter @bullet-poker/common run typecheck && pnpm --filter @bullet-poker/server run typecheck"
  },
  "deploy": {
    "startCommand": "pnpm --filter @bullet-poker/server run start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
